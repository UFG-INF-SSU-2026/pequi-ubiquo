# Copy to .env and adjust. All values are optional — sane defaults apply.

# Local LLM server (LM Studio / Ollama, OpenAI-compatible). Localhost-first.
LLM_BASE_URL=http://127.0.0.1:1234
# "auto" lets the server use whatever model is loaded; or pin a model id.
LLM_MODEL=auto
ASSISTANT_NAME=Tower

# Network (this is a LAN appliance; every route is behind login).
HOST=0.0.0.0
PORT=5000
MDNS_HOSTNAME=towerai

# Leave SECRET_KEY unset to auto-generate & persist to .secret_key
# SECRET_KEY=
MIN_PASSWORD_LEN=4

# --- Live Captions (transcription feature) ---------------------------------
# Serve HTTPS so remote speakers' browsers allow the mic (self-signed cert):
# USE_TLS=1              # requires: pip install cryptography
# Speech-to-text runs on Whisper (faster-whisper). Model size or a local path;
# a copy in models/faster-whisper-<size> is used automatically if present.
# WHISPER_MODEL=small        # tiny|base|small|medium|large-v3
# WHISPER_DEVICE=auto        # auto|cuda|cpu
# WHISPER_LANGUAGE=pt        # or "auto" to detect
# WHISPER_PARTIAL_SEC=auto   # live partial captions: auto (GPU only) | 0 (off) | seconds
# WHISPER_SILENCE_SEC=0.7    # pause that ends a caption line
# WHISPER_SILENCE_RMS=0.01   # raise in noisy rooms

# --- Login security ------------------------------------------------------------
# LOGIN_MAX_FAILURES=5       # failed logins per username (4x per client address)
# LOGIN_WINDOW_SEC=300

# --- Agent (assistant with tools, agent.py) -----------------------------------
# AGENT_ENABLED=1
# AGENT_PROTOCOL=native      # native tool calling; "text" for models without it
# AGENT_ALLOW_WRITES=1       # 0 = read-only tools
# AGENT_MAX_STEPS=6

# AGENT_CONFIRM_ACTIONS=1   # ✋ actions wait for Approve in chat
# AGENT_STREAM=1            # stream answers into the room
# AGENT_FEW_SHOT=2          # well-rated past answers shown as examples
# SCHEDULER_ENABLED=1

# --- Voice output, voices, vocabulary, files -------------------------------------
# TTS_VOICE=                # Piper voice path/name in models/piper/ (pt_BR preferred)
# VOICE_WAKE_WORDS=oi torre,ok torre,torre,hey tower,tower
# VOICE_MATCH_THRESHOLD=0.80  # remembered voices (see python voices.py compare)
# VOICE_MATCH_MARGIN=0.05
# VOICE_MIN_SECONDS=6
# VOCAB_ENABLED=1
# FILES_MAX_MB=50

# --- Backups ----------------------------------------------------------------------
# BACKUP_DIR=/media/usb/towerai   # automatic backups go here ("" = off)
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP=7

# --- Vision (images in chat) ---------------------------------------------------
# VISION_MODEL=              # vision-capable model id; empty = LLM_MODEL
# VISION_MAX_MB=10

# --- Meetings: uploads, speaker labels, summaries ---------------------------
# MAX_UPLOAD_MB=500
# KEEP_RECORDINGS=0          # 1 = keep uploaded audio in recordings/ after transcribing
# DIARIZATION_ENABLED=1      # "who said what" for uploads (needs models/diarization/)
# DIARIZATION_THRESHOLD=0.5  # lower => more speakers (when the count isn't given)
# SUMMARY_CHUNK_CHARS=12000  # longer transcripts are summarized in parts
# SUMMARY_TIMEOUT_SEC=300
